from abc import ABC, abstractmethod
from datetime import datetime
import re

# === EXCEPCIONES PERSONALIZADAS ===
class ErrorSistema(Exception): pass
class DatoInvalidoError(ErrorSistema): pass
class ServicioNoDisponibleError(ErrorSistema): pass
class ReservaInvalidaError(ErrorSistema): pass
class OperacionNoPermitidaError(ErrorSistema): pass
class ParametroFaltanteError(ErrorSistema): pass

# === CLASE ABSTRACTA BASE ===
class EntidadBase(ABC):
    contador_id = 0
    def __init__(self):
        EntidadBase.contador_id += 1
        self._id = EntidadBase.contador_id
    @property
    def id(self): return self._id
    @abstractmethod
    def mostrar_informacion(self): pass
    @abstractmethod
    def validar_datos(self): pass

# === CLASE CLIENTE ===
class Cliente(EntidadBase):
    def __init__(self, nombre, correo, telefono):
        self.__nombre = nombre
        self.__correo = correo
        self.__telefono = telefono
        self.validar_datos()
        super().__init__()
    
    @property
    def nombre(self): return self.__nombre
    @property
    def correo(self): return self.__correo
    @property
    def telefono(self): return self.__telefono
    
    def validar_datos(self):
        if len(self.__nombre.strip()) < 2:
            raise DatoInvalidoError("El nombre debe tener al menos 2 caracteres")
        if not self.__correo:
            raise ParametroFaltanteError("El correo es obligatorio")
        if "@" not in self.__correo or "." not in self.__correo:
            raise DatoInvalidoError("Formato de correo inválido")
        if len(self.__telefono) < 7:
            raise DatoInvalidoError("El teléfono debe tener al menos 7 dígitos")
    
    def mostrar_informacion(self):
        return f"Cliente #{self._id}: {self.__nombre} | Correo: {self.__correo} | Teléfono: {self.__telefono}"

# === CLASE ABSTRACTA SERVICIO ===
class Servicio(EntidadBase):
    def __init__(self, nombre, descripcion, disponible=True):
        self._nombre = nombre
        self._descripcion = descripcion
        self._disponible = disponible
        self.validar_datos()
        super().__init__()
    
    @property
    def nombre(self): return self._nombre
    @property
    def disponible(self): return self._disponible
    @disponible.setter
    def disponible(self, valor): self._disponible = valor
    
    def validar_datos(self):
        if not self._nombre: raise DatoInvalidoError("Nombre del servicio vacío")
    
    def verificar_disponibilidad(self):
        if not self._disponible:
            raise ServicioNoDisponibleError(f"Servicio '{self._nombre}' no disponible")
    
    @abstractmethod
    def calcular_costo(self, duracion, impuesto=0.0, descuento=0.0): pass
    @abstractmethod
    def mostrar_informacion(self): pass
# === SERVICIOS DERIVADOS ===
class ReservaSala(Servicio):
    def __init__(self, nombre, descripcion, capacidad, precio_hora, disponible=True):
        self.__capacidad = capacidad
        self.__precio_hora = precio_hora
        super().__init__(nombre, descripcion, disponible)
    
    def calcular_costo(self, duracion, impuesto=0.0, descuento=0.0):
        self.verificar_disponibilidad()
        if duracion <= 0: raise DatoInvalidoError("Duración debe ser mayor a 0")
        base = duracion * self.__precio_hora
        return round(base + base*impuesto - base*descuento, 2)
    
    def mostrar_informacion(self):
        estado = " Disponible" if self._disponible else " No disponible"
        return f"Sala: {self._nombre} | Capacidad: {self.__capacidad} | ${self.__precio_hora}/h | {estado}"


class AlquilerEquipo(Servicio):
    def __init__(self, nombre, descripcion, tipo_equipo, precio_dia, disponible=True):
        self.__tipo = tipo_equipo
        self.__precio_dia = precio_dia
        super().__init__(nombre, descripcion, disponible)
    
    def calcular_costo(self, duracion, impuesto=0.0, descuento=0.0):
        self.verificar_disponibilidad()
        if duracion <= 0: raise DatoInvalidoError("Días deben ser mayores a 0")
        base = duracion * self.__precio_dia
        return round(base + base*impuesto - base*descuento, 2)
    
    def mostrar_informacion(self):
        estado = " Disponible" if self._disponible else " No disponible"
        return f"Equipo: {self._nombre} | Tipo: {self.__tipo} | ${self.__precio_dia}/día | {estado}"


class AsesoriaEspecializada(Servicio):
    def __init__(self, nombre, descripcion, especialista, valor_sesion, disponible=True):
        self.__especialista = especialista
        self.__valor = valor_sesion
        super().__init__(nombre, descripcion, disponible)
    
    def calcular_costo(self, duracion, impuesto=0.0, descuento=0.0):
        self.verificar_disponibilidad()
        if duracion <= 0: raise DatoInvalidoError("Sesiones deben ser mayores a 0")
        base = duracion * self.__valor
        return round(base + base*impuesto - base*descuento, 2)
    
    def mostrar_informacion(self):
        estado = " Disponible" if self._disponible else " No disponible"
        return f"Asesoría: {self._nombre} | Especialista: {self.__especialista} | ${self.__valor}/sesión | {estado}"
# === CLASE RESERVA ===
class Reserva:
    def __init__(self, cliente, servicio, duracion):
        if not cliente: raise ReservaInvalidaError("Falta cliente")
        if not servicio: raise ReservaInvalidaError("Falta servicio")
        if duracion <= 0: raise ReservaInvalidaError("Duración inválida")
        self.cliente = cliente
        self.servicio = servicio
        self.duracion = duracion
        self.estado = "PENDIENTE"
        self.fecha = datetime.now()
        self.costo_final = 0.0
    
    def confirmar(self, impuesto=0.0, descuento=0.0):
        if self.estado != "PENDIENTE":
            raise OperacionNoPermitidaError("Solo se confirman reservas pendientes")
        self.servicio.verificar_disponibilidad()
        self.costo_final = self.servicio.calcular_costo(self.duracion, impuesto, descuento)
        self.estado = "CONFIRMADA"
        return f" Reserva confirmada. Costo: ${self.costo_final}"
    
    def cancelar(self):
        if self.estado == "COMPLETADA":
            raise OperacionNoPermitidaError("No se puede cancelar una reserva completada")
        self.estado = "CANCELADA"
        return " Reserva cancelada"
    
    def mostrar_detalle(self):
        return f"""
=== RESERVA ===
Fecha: {self.fecha.strftime('%d/%m/%Y %H:%M')}
Cliente: {self.cliente.nombre}
Servicio: {self.servicio.nombre}
Duración: {self.duracion}
Estado: {self.estado}
Costo: ${self.costo_final}
"""

# === GESTOR DEL SISTEMA ===
class GestorSistema:
    def __init__(self, archivo_log="logs.txt"):
        self.archivo_log = archivo_log
        self.clientes = []
        self.servicios = []
        self.reservas = []
        self._log("INICIO", "Sistema iniciado")
    
    def _log(self, nivel, mensaje):
        with open(self.archivo_log, "a", encoding="utf-8") as f:
            f.write(f"[{datetime.now().strftime('%d/%m %H:%M')}] [{nivel}] {mensaje}\n")
    
    def registrar_cliente(self, nombre, correo, telefono):
        try:
            c = Cliente(nombre, correo, telefono)
        except ErrorSistema as e:
            self._log("ERROR", f"Cliente '{nombre}': {e}")
            raise
        else:
            self.clientes.append(c)
            self._log("INFO", f"Cliente registrado: {c.nombre}")
            return c
    
    def registrar_servicio(self, servicio):
        try:
            if not isinstance(servicio, Servicio):
                raise ErrorSistema("No es un servicio válido")
            servicio.validar_datos()
        except ErrorSistema as e:
            self._log("ERROR", f"Servicio: {e}")
            raise
        else:
            self.servicios.append(servicio)
            self._log("INFO", f"Servicio: {servicio.nombre}")
            return servicio
    
    def crear_reserva(self, cliente, servicio, duracion):
        try:
            r = Reserva(cliente, servicio, duracion)
        except ErrorSistema as e:
            self._log("ERROR", f"Reserva: {e}")
            raise
        else:
            self.reservas.append(r)
            self._log("INFO", f"Reserva: {cliente.nombre} + {servicio.nombre}")
            return r
